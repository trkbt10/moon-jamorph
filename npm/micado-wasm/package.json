{
  "name": "micado",
  "version": "0.1.0",
  "description": "micado tokenizer: unified dic.bin runtime with profile-selectable dictionaries",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dic-bin": {
      "types": "./dist/dic-bin.d.ts",
      "import": "./dist/dic-bin.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:wasm": "../../tools/distribution/build_wasm_npm.sh",
    "typecheck": "tsc --noEmit",
    "test:smoke": "tsx ./demo/node-smoke.ts",
    "test:dic": "tsx ./demo/node-dic-smoke.ts",
    "test:accuracy": "tsx ./demo/accuracy-cli.ts",
    "dev": "vite",
    "preview:demo": "vite --host --open"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "keywords": [
    "japanese",
    "tokenizer",
    "morphological-analysis",
    "moonbit",
    "wasm",
    "dic-bin",
    "deflate"
  ],
  "license": "Apache-2.0"
}
