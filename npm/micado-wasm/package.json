{
  "name": "@micado/wasm",
  "version": "0.1.0",
  "description": "micado tokenizer: unified dic.bin runtime with profile-selectable dictionaries",
  "type": "module",
  "exports": {
    ".": "./index.mjs",
    "./dic-bin": "./dic-bin.mjs"
  },
  "files": [
    "index.mjs",
    "dic-bin.mjs",
    "dist/*.dic.bin",
    "dist/*.dic.bin.deflate",
    "README.md",
    "demo"
  ],
  "scripts": {
    "build:wasm": "../../tools/distribution/build_wasm_npm.sh",
    "test:node": "node ./demo/node-smoke.mjs",
    "test:dic": "node ./demo/node-dic-smoke.mjs",
    "test:accuracy": "node ./demo/accuracy-cli.mjs",
    "preview:demo": "vite demo --host --open"
  },
  "devDependencies": {
    "vite": "^6.0.0"
  },
  "keywords": [
    "japanese",
    "tokenizer",
    "morphological-analysis",
    "moonbit",
    "wasm",
    "dic-bin",
    "deflate"
  ],
  "license": "Apache-2.0"
}
