{
  "name": "@trkbt10/micado",
  "version": "0.6.1",
  "description": "Japanese morphological analyzer with WASM runtime and streaming support",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./streaming": {
      "types": "./dist/streaming.d.ts",
      "import": "./dist/streaming.js"
    },
    "./wasm": "./dist/micado_wasm.wasm",
    "./cli-wasm": "./dist/micado_cli.wasm",
    "./dict/tiny": "./dist/tiny.dic.bin.deflate",
    "./dict/mini": "./dist/mini.dic.bin.deflate",
    "./dict/medium": "./dist/medium.dic.bin.deflate",
    "./dict/full": "./dist/full.dic.bin.deflate",
    "./dict/LICENSE": "./dist/LICENSE.dic.bin"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "micado": "./bin/micado.mjs"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.wasm",
    "dist/tiny.dic.bin.deflate",
    "dist/mini.dic.bin.deflate",
    "dist/medium.dic.bin.deflate",
    "dist/full.dic.bin.deflate",
    "dist/LICENSE.dic.bin",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:wasm": "../../tools/distribution/build_wasm_npm.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "test": "tsx --test test/**/*.test.ts",
    "test:smoke": "tsx ./demo/node-smoke.ts",
    "test:streaming": "tsx ./demo/node-streaming.ts",
    "test:accuracy": "tsx ./demo/accuracy-cli.ts",
    "dev": "vite",
    "preview:demo": "vite --host --open"
  },
  "dependencies": {
    "@trkbt10/micado-streaming": "file:../../packages/micado-streaming"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.0",
    "vite": "^6.0.0"
  },
  "keywords": [
    "japanese",
    "tokenizer",
    "morphological-analysis",
    "moonbit",
    "wasm",
    "streaming"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/trkbt10/moon-jamorph"
  }
}
